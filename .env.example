# Copie para .env (não versionado) e ajuste os valores.
# Os padrões funcionam com o docker-compose do repositório oficina-infra-k8s.
DB_PASSWORD=admin_password
RABBITMQ_PASSWORD=admin_password

# Mercado Pago (obrigatório para gerar links de pagamento)
# Use um token de TESTE (começa com TEST-) em desenvolvimento.
MERCADOPAGO_ACCESS_TOKEN=
# URL pública que o Mercado Pago chama no webhook (ex.: túnel do ngrok)
MERCADOPAGO_NOTIFICATION_URL=
